# Database Configuration
DB_USER=user
DB_PASSWORD=password
DB_NAME=TYPE_NOTE
DB_HOST=localhost
DB_PORT=5432

# Database URL for application
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

# Database URL for migrations (use localhost when running migrate from host)
MIGRATION_DATABASE_URL=postgres://user:password@localhost:5432/TYPE_NOTE?sslmode=disable

# Server
PORT=8080
